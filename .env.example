# Copy to .env on the server and replace every CHANGE_ME value (infrastructure/scripts/server-setup.sh does it for you).
# Generate secrets with: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://support:CHANGE_ME_RANDOM_DATABASE_PASSWORD@postgres:5432/support
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# The support bot: token from @BotFather and the key the bot uses to talk to the backend.
BOT_TOKEN=
BOT_SERVICE_KEY=CHANGE_ME_RANDOM_SERVICE_KEY_AT_LEAST_32_CHARS
# Name of this bot in the data (users, tickets and campaigns carry it): keep "main" unless you run several bots.
BOT_ID=main
# Empty: long polling. Webhook: the public address, e.g. https://support.example.com (Plesk forwards /telegram/webhook).
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=CHANGE_ME_RANDOM_WEBHOOK_SECRET

# Public address of the dashboard (exactly as in the browser, no trailing /)
ADMIN_ORIGIN=https://support.example.com
COOKIE_SECURE=true
API_INTERNAL_URL=http://api:8000
# Localhost ports published for Plesk. The media platform on the same server uses 18000/18080.
API_PORT=18100
DASHBOARD_PORT=18180
WEBHOOK_PORT=18181

# Files and backups (Docker volumes)
STORAGE_DIR=/data/files
BACKUP_DIR=/data/backups
BACKUP_KEEP=14
BACKUP_HOUR=3

DEFAULT_LANGUAGE=en
WORKER_CONCURRENCY=2
SESSION_HOURS=12
# Optional error tracking: a Sentry (or self-hosted GlitchTip) DSN. Empty = no reports are sent.
SENTRY_DSN=
# development, testing or production: shown in the dashboard (System) and in error reports
ENVIRONMENT=production
